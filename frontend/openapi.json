{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "誤りの応答。",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "ログインの要求。社員番号の形(数字 6 桁)の誤りも、ほかの失敗と同じ 401 にする(FR-024)。",
        "properties": {
          "employee_no": {
            "title": "Employee No",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "employee_no",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "description": "ログイン中の利用者(FR-009・FR-014)。役割は役割の並び順。",
        "properties": {
          "department": {
            "title": "Department",
            "type": "string"
          },
          "employee_no": {
            "title": "Employee No",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleResponse"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "employee_no",
          "name",
          "department",
          "roles"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MenuGroupResponse": {
        "description": "役割 1 つ分の項目のまとまり。",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MenuItemResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/RoleResponse"
          }
        },
        "required": [
          "role",
          "items"
        ],
        "title": "MenuGroupResponse",
        "type": "object"
      },
      "MenuItemResponse": {
        "description": "メニューの項目 1 つ。available が偽なら、先の画面がまだない(準備中。FR-019)。",
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "available"
        ],
        "title": "MenuItemResponse",
        "type": "object"
      },
      "MenuResponse": {
        "description": "メニュー。役割の順(社員・上長・購買担当・管理者。FR-017)に、役割ごとにまとめて並べる。",
        "properties": {
          "groups": {
            "items": {
              "$ref": "#/components/schemas/MenuGroupResponse"
            },
            "title": "Groups",
            "type": "array"
          }
        },
        "required": [
          "groups"
        ],
        "title": "MenuResponse",
        "type": "object"
      },
      "RoleResponse": {
        "description": "役割 1 つ。",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "RoleResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "購買と在庫の業務アプリ",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "ログインする。成功ならログインの状態を作り、印をクッキーで返す。\n\n失敗(登録のない社員番号・数字 6 桁でない社員番号・誤ったパスワード・ロック中・役割なし)は、\nどれも 401 と共通の文で返す。誤った回数とロックの書き込みは、401 を返しても確定する。",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Login"
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "ログアウトする。その印のログインの状態を消し、クッキーを消す。ログインの状態がなくても 204。",
        "operationId": "logout_api_auth_logout_post",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/me": {
      "get": {
        "description": "ログイン中の利用者を返す。ログインしていなければ 401。",
        "operationId": "me_api_me_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Me"
      }
    },
    "/api/menu": {
      "get": {
        "description": "ログイン中の利用者のメニューを返す。ログインしていなければ 401。",
        "operationId": "menu_api_menu_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Menu"
      }
    }
  }
}
